# For running the bot locally. In Home Assistant, use the app's options instead.
BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_WHITELIST_USER_IDS=[123456789]
ADMIN_USER_IDS=[123456789]
DATABASE_URL=sqlite+aiosqlite:///./data/diabetes.db
OPENAI_API_KEY=your_openai_api_key
# USDA FoodData Central nutrition lookup. "DEMO_KEY" works with no signup but is rate-limited;
# get a free key (1,000 req/hour) at https://api.nal.usda.gov/fdc/api-key-signup/
USDA_API_KEY=DEMO_KEY
MODEL_REGULAR_HEAVY=gpt-5.6-luna
MODEL_REGULAR_LIGHT=gpt-5.6-luna
MODEL_SUPER_HEAVY=gpt-5.6-terra
MODEL_SUPER_LIGHT=gpt-5.6-luna
MODEL_UNLIMITED_HEAVY=gpt-5.6-terra
MODEL_UNLIMITED_LIGHT=gpt-5.6-luna

CHAT_HISTORY_LIMIT=15
CHAT_CONTEXT_DB_LOOKBACK_HOURS=24
CHAT_CONTEXT_LOGS_LIMIT=15
EMERGENCY_TIMER_MINUTES=15
USE_AI_TIMING_HINTS=False

# Optional. Sync and CGM features need all three.
NIGHTSCOUT_URL=
NIGHTSCOUT_TOKEN=
PATIENT_TELEGRAM_ID=0
DASHBOARD_URL=
